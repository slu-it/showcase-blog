{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:open": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "ng lint",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.17",
    "@angular/compiler": "^20.3.17",
    "@angular/core": "^20.3.17",
    "@angular/forms": "^20.3.17",
    "@angular/platform-browser": "^20.3.17",
    "@angular/router": "^20.3.17",
    "@ngrx/signals": "^20.1.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "marked": "16.4.2",
    "ngx-markdown": "20.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.17",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^20.3.17",
    "@esbuild/linux-arm64": "^0.25.9",
    "@playwright/test": "^1.58.2",
    "@types/jest": "^29.5.14",
    "angular-eslint": "^21.3.0",
    "eslint": "9.39.2",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-preset-angular": "14.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.59.0"
  },
  "pnpm": {
    "overrides": {
      "rollup": "^4.59.0",
      "@angular/build>rollup": "^4.59.0",
      "vite>rollup": "^4.59.0",
      "handlebars": "^4.7.9",
      "hono": "^4.12.4",
      "@hono/node-server": "^1.19.10",
      "express-rate-limit": "^8.2.2",
      "minimatch@^9": "9.0.7",
      "minimatch@^10": "10.2.3",
      "tar": "^7.5.11",
      "flatted": "^3.4.2"
    }
  }
}
